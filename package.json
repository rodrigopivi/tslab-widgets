{
  "name": "tslab-widgets",
  "version": "1.0.0",
  "description": "A set of widgets for ts-lab environment including financial charts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && npx tsc",
    "prebuild": "npm run validate",
    "validate": "tsx scripts/validate-versions.ts",
    "reset": "rm -rf node_modules && rm -rf dist && npm install",
    "format": "npx @biomejs/biome format --write",
    "lint": "npx @biomejs/biome lint --write",
    "check": "npx @biomejs/biome check --write"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tslab",
    "jupyter",
    "widgets",
    "chart",
    "candlesticks",
    "json",
    "csv",
    "typescript",
    "ipynb",
    "data science",
    "jupyter-lab",
    "notebook",
    "lightweight-charts"
  ],
  "author": "Rodrigo P. (https://github.com/rodrigopivi)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigopivi/tslab-widgets"
  },
  "bugs": {
    "url": "https://github.com/rodrigopivi/tslab-widgets/issues"
  },
  "homepage": "https://github.com/rodrigopivi/tslab-widgets#readme",
  "private": false,
  "dependencies": {
    "tslab": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@biomejs/biome": "2.3.10",
    "@types/node": "25.0.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cspell": "9.4.0",
    "lightweight-charts": "5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "2.8.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tslab": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}